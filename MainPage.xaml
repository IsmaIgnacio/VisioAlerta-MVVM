<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VisioAlerta.App.ViewModels"
             x:Class="VisioAlerta.App.MainPage"
             BackgroundColor="#F4F6F8"
             Title="VisioAlerta">

    <ContentPage.BindingContext>
        <viewmodels:DashboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="25">

            <!-- TITULO -->
            <Label
                Text="VISIOALERTA"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="#D32F2F"
                HorizontalOptions="Center" />

            <Label
                Text="Sistema inteligente de monitoreo"
                FontSize="16"
                TextColor="Gray"
                HorizontalOptions="Center" />

            <!-- ICONO -->
            <Image
                Source="dotnet_bot.png"
                HeightRequest="120"
                HorizontalOptions="Center" />

            <!-- TARJETA -->
            <Frame
                CornerRadius="25"
                Padding="25"
                BackgroundColor="#E53935"
                HasShadow="True">

                <VerticalStackLayout Spacing="20">

                    <!-- PACIENTE -->
                    <HorizontalStackLayout Spacing="10">

                        <Label
                            Text="👤"
                            FontSize="28" />

                        <VerticalStackLayout>

                            <Label
                                Text="Paciente"
                                FontSize="16"
                                TextColor="White"
                                Opacity="0.8" />

                            <Label
                                Text="{Binding AlertaActual.Paciente}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- IMPACTO -->
                    <HorizontalStackLayout Spacing="10">

                        <Label
                            Text="⚠️"
                            FontSize="28" />

                        <VerticalStackLayout>

                            <Label
                                Text="Impacto Detectado"
                                FontSize="16"
                                TextColor="White"
                                Opacity="0.8" />

                            <Label
                                Text="{Binding AlertaActual.FuerzaImpactoG}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- ESTADO -->
                    <Frame
                        BackgroundColor="#FFFFFF"
                        CornerRadius="15"
                        Padding="15">

                        <VerticalStackLayout>

                            <Label
                                Text="Estado del Sistema"
                                FontSize="16"
                                HorizontalOptions="Center"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding AlertaActual.Estado}"
                                FontSize="32"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                TextColor="#D32F2F" />

                        </VerticalStackLayout>

                    </Frame>

                </VerticalStackLayout>

            </Frame>

            <!-- BOTON -->
            <Button
                Text="Actualizar Estado"
                BackgroundColor="#D32F2F"
                TextColor="White"
                CornerRadius="15"
                HeightRequest="55"
                FontAttributes="Bold" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>